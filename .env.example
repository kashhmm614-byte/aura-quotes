# ============================================================================
# AuraQuote — Environment Variables Configuration
# ============================================================================

# 1. Google OAuth 2.0 Client ID (Web Application)
# Obtain from https://console.cloud.google.com/apis/credentials
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Supabase Cloud Database Credentials
# Obtain from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 3. Local Server Port (Optional)
PORT=3000
